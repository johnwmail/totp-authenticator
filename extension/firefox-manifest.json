{
    "manifest_version": 2,
    "name": "TOTP Authenticator",
    "version": "1.0.0",
    "description": "A lightweight TOTP authenticator that runs entirely in your browser",
    "author": "TOTP Authenticator",
    "homepage_url": "https://github.com/johnwmail/totp-authenticator",

    "browser_action": {
        "default_popup": "popup/index.html",
        "default_title": "TOTP Authenticator",
        "default_icon": {
            "16": "icons/icon_16.png",
            "48": "icons/icon_48.png",
            "128": "icons/icon_128.png"
        }
    },

    "icons": {
        "16": "icons/icon_16.png",
        "48": "icons/icon_48.png",
        "128": "icons/icon_128.png"
    },

    "permissions": [
        "storage",
        "alarms"
    ],

    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },

    "content_security_policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'",

    "browser_specific_settings": {
        "gecko": {
            "id": "totp-authenticator@example.com",
            "strict_min_version": "57.0"
        }
    }
}
